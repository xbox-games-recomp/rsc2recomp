# ---------------------------------------------------------------------------
# Nothing derived from the game is committed. You supply your own dump.
# ---------------------------------------------------------------------------

# Game files (your unpacked retail disc)
/game_files/
/game_files
*.xbe
*.iso
*.xiso

# Generated C from the XBE (regenerate with scripts\regen.ps1)
/src/recomp/gen/

# Builds and snapshot executables (contain recompiled game code)
build/
/snapshots/
*.exe
*.pdb
*.ilk
*.obj
*.lib
*.dll

# Run output: frame dumps, audio/vertex dumps, logs, captured stdout/stderr
/frames/
*.bmp
*.wav
*.raw
*.log
*.err
*.out
*.e
/*.txt
!/CMakeLists.txt
*.bak
*.bak2

# Python / editors / OS
__pycache__/
*.pyc
.venv/
.vs/
.vscode/
.idea/
Thumbs.db
.DS_Store

# Compiled vertex programs (built from the game's microcode at run time)
/shader_cache/

# ABI-check build (/DRECOMP_ABI_CHECK), see NOTES 10
/build_abi/

# Test runs: repo-local save dir (RECOMP_SAVE_DIR) and live pad input file
/savedata/
/pad_live.txt
/saveroot/

# Flight-recorder captures (F12 / RECOMP_D3D11_RING_AUTO)
/flicker/


# Launcher: per-user choices
launcher.user.ini
setup.log
